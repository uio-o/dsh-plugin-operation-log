{
  "name": "dsh-plugin-operation-log",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "按会话/轮次/步骤统计 Skill 调用、MCP 调用与文件变动，诚实区分已知与未知数据。",
  "license": "MIT",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uio-o/dsh-plugin-operation-log.git"
  },
  "homepage": "https://github.com/uio-o/dsh-plugin-operation-log",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.js", "client.js", "icon.svg", "locale/*.json"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}
